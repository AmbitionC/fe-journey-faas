{
  "name": "midway_faas_project",
  "private": true,
  "version": "1.0.0",
  "description": "Midway Serverless for the Serverless environment",
  "type": "commonjs",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "serverless",
    "midway"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/function --port 7001",
    "test": "cross-env NODE_ENV=unittest mocha --require ts-node/register",
    "cov": "cross-env c8 --include src --all --reporter=text --reporter=lcovonly npm run test",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir",
    "generate": "serverless-yaml-generator",
    "deploy": "sh deploy.sh"
  },
  "dependencies": {
    "@midwayjs/cache": "^3.12.0",
    "@midwayjs/captcha": "^3.16.5",
    "@midwayjs/core": "^3.12.0",
    "@midwayjs/cross-domain": "^3.12.0",
    "@midwayjs/decorator": "^3.16.2",
    "@midwayjs/faas": "^3.12.0",
    "@midwayjs/fc-starter": "^3.12.0",
    "@midwayjs/logger": "^3.1.0",
    "@midwayjs/redis": "^3.16.5",
    "@midwayjs/static-file": "^3.11.16",
    "@midwayjs/swagger": "^3.11.16",
    "@midwayjs/typeorm": "^3.16.5",
    "@midwayjs/validate": "^3.16.5",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^5.2.3",
    "cache-manager-ioredis": "^2.1.0",
    "lodash": "^4.17.21",
    "mini-svg-data-uri": "^1.4.4",
    "mysql2": "^3.10.3",
    "nanoid": "^3.3.7",
    "node-fetch": "^2.7.0",
    "svg-captcha": "^1.4.0",
    "swagger-ui-dist": "^4.19.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.12.0",
    "@midwayjs/serverless-yaml-generator": "^1.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16",
    "@types/node-fetch": "^2.6.13",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.1.0"
  },
  "engines": {
    "node": ">=16"
  }
}
