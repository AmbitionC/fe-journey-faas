# Database
DB_HOST=your-mysql-host.rds.aliyuncs.com
DB_USER=your_db_username
DB_PASS=your_db_password

# Redis
REDIS_HOST=your-redis-host.redis.rds.aliyuncs.com
REDIS_PASS=your_redis_password

# Judge0 (algorithm execution)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# AI / LLM
# Provider options: qwen (default), openai
LLM_PROVIDER=qwen
LLM_API_KEY=your_dashscope_or_openai_api_key
LLM_MODEL=qwen-max

# AI rate limits (requests per hour)
AI_RATE_FREE=30
AI_RATE_MEMBER=200
