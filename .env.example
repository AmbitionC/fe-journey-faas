# Database
DB_HOST=your-mysql-host.rds.aliyuncs.com
DB_USER=your_db_username
DB_PASS=your_db_password

# Redis
REDIS_HOST=your-redis-host.redis.rds.aliyuncs.com
REDIS_PASS=your_redis_password

# Judge0 (algorithm execution)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# AI / LLM
# Provider options: qwen (default), openai
LLM_PROVIDER=qwen
LLM_API_KEY=your_dashscope_or_openai_api_key
LLM_MODEL=qwen-max

# AI rate limits (requests per hour)
AI_RATE_FREE=30
AI_RATE_MEMBER=200

# Health module (/health/* — personal health management, decoupled)
HEALTH_DB_NAME=health
HEALTH_API_TOKEN=your_random_long_token
# Vision model for meal photo recognition (OpenAI-compatible; optional)
HEALTH_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HEALTH_VISION_API_KEY=
HEALTH_VISION_MODEL=qwen-vl-max
# Extra CORS origins for server.js (comma separated; *.vercel.app already allowed)
EXTRA_CORS_ORIGINS=

# Content sync & growth export (x-sync-secret header)
SYNC_SECRET=your_random_long_secret
# Growth: internal/self-test accounts (phone numbers, comma separated),
# excluded from all growth metrics. Injected via GitHub secret in deploy.
GROWTH_INTERNAL_USER_IDS=
